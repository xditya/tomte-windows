<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Unpackaged while developing; the MSIX comes from tools/package. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Win32 icon resource so the exe shows the tomte in Explorer. -->
    <ApplicationIcon>Assets\tomte.ico</ApplicationIcon>
    <SelfContained>false</SelfContained>
    <!-- A self-contained publish also bundles the Windows App SDK runtime. Set here, not on the
         command line, because the global property would reach the Tomte.Panels class library and fail. -->
    <WindowsAppSDKSelfContained Condition="'$(SelfContained)' == 'true'">true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <!-- Win2D only builds the CompositionPath; Windows App SDK is its dependency. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tomte.Core\Tomte.Core.csproj" />
    <!-- Loaded only by the settings process (Tomte.Shell.exe with the settings switch). -->
    <ProjectReference Include="..\Tomte.Panels\Tomte.Panels.csproj" />
    <!-- Loaded only when the palette opens. -->
    <ProjectReference Include="..\Tomte.AI\Tomte.AI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\tomte.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The app's resource index holds the WinUI theme resources the settings window starts with. The build makes it,
       but only the MSIX tooling, which an unpackaged build leaves out, adds it to a publish. -->
  <Target Name="PublishProjectPri" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" RelativePath="$(ProjectPriFileName)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
