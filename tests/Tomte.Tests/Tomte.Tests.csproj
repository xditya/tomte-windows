<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
    <!-- JobTests makes a tagged stand-in window through the AI layer's Win32 declarations. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- StorageTests starts this assembly as a second process, so it brings its own Main. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Tomte.Core\Tomte.Core.csproj" />
    <!-- Also as "ai": Core and AI both carry Win32 declarations of their own, and JobTests needs AI's. -->
    <ProjectReference Include="..\..\src\Tomte.AI\Tomte.AI.csproj" Aliases="global,ai" />
    <!-- The MCP tests start this server as a real child process; its exe lands next to the tests. -->
    <ProjectReference Include="..\..\tools\McpEchoServer\McpEchoServer.csproj" />
    <!-- The text box test drives the island's text boxes offscreen with this tool; its exe lands next to the tests. -->
    <ProjectReference Include="..\..\tools\TextCaptures\TextCaptures.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
